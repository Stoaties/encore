# cp encore-secrets.env.example encore-secrets.env  (encore-secrets.env is gitignored)
DATABASE_URL=postgres://encore:change-me@postgres.databases.svc.cluster.local:5432/encore
JWT_SECRET=generate-a-long-random-string
# optional: lets Encore trigger library scans and validate sessions server-side
JELLYFIN_API_KEY=
SLSKD_API_KEY=change-me
# only needed for Spotify playlist import
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# only needed for YouTube playlist import
YOUTUBE_API_KEY=
