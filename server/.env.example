# --- required ---
DATABASE_URL=postgres://musicapp:musicapp@localhost:5433/musicapp
JELLYFIN_URL=http://localhost:8096
# secret for signing app session JWTs — generate something long and random
JWT_SECRET=change-me
# where finished music lands (the path Jellyfin's music library points at, as seen by THIS server)
MUSIC_LIBRARY_PATH=/data/media/music
# scratch space for in-progress downloads (same filesystem as MUSIC_LIBRARY_PATH ideally)
STAGING_PATH=/data/staging

# --- acquisition (slskd) ---
SLSKD_URL=http://localhost:5030
SLSKD_API_KEY=devkey
# path where THIS server sees slskd's completed downloads directory
SLSKD_DOWNLOADS_PATH=

# --- metadata ---
# identify yourself to MusicBrainz (required by their ToS)
MUSICBRAINZ_USER_AGENT=Encore/0.1.0 (you@example.com)

# --- optional: playlist import ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# --- server ---
PORT=8080
# path to the built web app; leave unset in dev (vite serves it)
WEB_DIST=
